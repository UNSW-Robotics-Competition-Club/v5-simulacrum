+/*
+ * VEX V5 / vexide-v5gdb: true if an ARMv7 address-mismatch hardware breakpoint
+ * (DBGBCR.BT == 0b0100, enabled) is active and would generate debug exceptions
+ * in the current mode. Used to force per-instruction stepping so the mismatch
+ * can fire on the next instruction (QEMU has no native mismatch-bp support).
+ * Gated to v5gdb's privilege filter (User/System/Supervisor) so the debugger's
+ * own abort/IRQ-mode handler code is not single-stepped.
+ */
+static bool arm_mismatch_step_active(CPUARMState *env)
+{
+    int n, brps;
+
+    if (is_a64(env) || arm_feature(env, ARM_FEATURE_M)) {
+        return false;
+    }
+    if (extract32(env->cp15.mdscr_el1, 15, 1) == 0
+        || !arm_generate_debug_exceptions(env)) {
+        return false;
+    }
+    brps = arm_num_brps(env_archcpu(env));
+    for (n = 0; n < brps; n++) {
+        uint64_t bcr = env->cp15.dbgbcr[n];
+        if (extract64(bcr, 0, 1) && extract64(bcr, 20, 4) == 4) {
+            return true;
+        }
+    }
+    return false;
+}
+
 static CPUARMTBFlags rebuild_hflags_common_32(CPUARMState *env, int fp_el,
                                               ARMMMUIdx mmu_idx,
                                               CPUARMTBFlags flags)
@@ -102,6 +131,10 @@ static CPUARMTBFlags rebuild_hflags_common_32(CPUARMState *env, int fp_el,
     }
     DP_TBFLAG_A32(flags, NS, !access_secure_reg(env));
 
+    if (arm_mismatch_step_active(env)) {
+        DP_TBFLAG_ANY(flags, VEX_MISMATCH_STEP, 1);
+    }
+
     return rebuild_hflags_common(env, fp_el, mmu_idx, flags);
 }
 
