+/*
+ * VEX V5 / Zynq-7000 Cortex-A9: expose a valid memory-mapped debug interface
+ * address so self-hosted debuggers (e.g. vexide/v5gdb) can locate the APB
+ * debug register bank. Upstream QEMU RAZes these because it has no MMIO debug
+ * component; the vex-v5 machine maps a backing bank at 0xF8890000 (CPU0) /
+ * 0xF8892000 (CPU1), matching real Zynq-7000 silicon.
+ */
+static uint64_t vex_dbgdrar_read(CPUARMState *env, const ARMCPRegInfo *ri)
+{
+    ARMCPU *cpu = env_archcpu(env);
+    if ((cpu->midr & 0xff0ffff0) == 0x410fc090) {
+        return 0xF8800000ULL | 0x3;       /* CoreSight ROM base, Valid */
+    }
+    return 0;
+}
+
+static uint64_t vex_dbgdsar_read(CPUARMState *env, const ARMCPRegInfo *ri)
+{
+    ARMCPU *cpu = env_archcpu(env);
+    if ((cpu->midr & 0xff0ffff0) == 0x410fc090) {
+        uint32_t aff0 = cpu->mp_affinity & 0xff;   /* 0 -> CPU0, 1 -> CPU1 */
+        return (uint64_t)(((0x90000U + 0x2000U * aff0) & 0xfffff000U) | 0x3U);
+    }
+    return 0;
+}
+
 static const ARMCPRegInfo debug_cp_reginfo[] = {
     /*
      * DBGDRAR, DBGDSAR: always RAZ since we don't implement memory mapped
@@ -181,14 +207,14 @@ static const ARMCPRegInfo debug_cp_reginfo[] = {
