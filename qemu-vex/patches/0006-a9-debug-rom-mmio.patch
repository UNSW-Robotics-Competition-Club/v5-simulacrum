diff --git a/target/arm/tcg/debug.c b/target/arm/tcg/debug.c
index 528d288..1e984be 100644
--- a/target/arm/tcg/debug.c
+++ b/target/arm/tcg/debug.c
@@ -772,3 +772,133 @@ vaddr arm_adjust_watchpoint_address(CPUState *cs, vaddr addr, int len)
 }
 
 #endif /* !CONFIG_USER_ONLY */
+
+/*
+ * VEX V5 / Zynq-7000: memory-mapped (APB) debug register bank access for the
+ * Cortex-A9. Real silicon exposes the debug register file both via CP14 and as
+ * a memory-mapped bank; QEMU only implements the CP14 view. vexide/v5gdb drives
+ * hardware breakpoints and single-step through the memory-mapped bank, so route
+ * the register offsets it uses to the CPU cp15 debug state and QEMU's existing
+ * breakpoint machinery. Writes run in vCPU context (a guest store to the bank),
+ * exactly like the CP14 writefns, so calling hw_breakpoint_update() here is
+ * safe.
+ */
+void arm_cpu_debug_mmio_write(ARMCPU *cpu, hwaddr offset, uint64_t value)
+{
+    CPUARMState *env = &cpu->env;
+    int n;
+
+    switch (offset) {
+    case 0x100 ... 0x13c:                 /* DBGBVR<n> */
+        n = (offset - 0x100) >> 2;
+        if (n < arm_num_brps(cpu)) {
+            env->cp15.dbgbvr[n] = value;
+            hw_breakpoint_update(cpu, n);
+        }
+        break;
+    case 0x140 ... 0x17c:                 /* DBGBCR<n> */
+        n = (offset - 0x140) >> 2;
+        if (n < arm_num_brps(cpu)) {
+            /* BAS[3]/[1] are read-only copies of BAS[2]/[0]. */
+            value = deposit64(value, 6, 1, extract64(value, 5, 1));
+            value = deposit64(value, 8, 1, extract64(value, 7, 1));
+            env->cp15.dbgbcr[n] = value;
+            hw_breakpoint_update(cpu, n);
+        }
+        break;
+    case 0x180 ... 0x1bc:                 /* DBGWVR<n> */
+        n = (offset - 0x180) >> 2;
+        if (n < arm_num_wrps(cpu)) {
+            env->cp15.dbgwvr[n] = value;
+            hw_watchpoint_update(cpu, n);
+        }
+        break;
+    case 0x1c0 ... 0x1fc:                 /* DBGWCR<n> */
+        n = (offset - 0x1c0) >> 2;
+        if (n < arm_num_wrps(cpu)) {
+            env->cp15.dbgwcr[n] = value;
+            hw_watchpoint_update(cpu, n);
+        }
+        break;
+    case 0x088:                           /* DBGDSCRext: only MDE writable */
+        env->cp15.mdscr_el1 = deposit64(env->cp15.mdscr_el1, 15, 1,
+                                        extract64(value, 15, 1));
+        break;
+    default:
+        break;                            /* lock / OS / ID regs: WI */
+    }
+
+    arm_rebuild_hflags(&cpu->env);
+}
+
+uint64_t arm_cpu_debug_mmio_read(ARMCPU *cpu, hwaddr offset)
+{
+    CPUARMState *env = &cpu->env;
+    int n;
+
+    switch (offset) {
+    case 0x000:                           /* DBGDIDR */
+        return cpu->isar.dbgdidr;
+    case 0x088:                           /* DBGDSCRext */
+        return env->cp15.mdscr_el1;
+    case 0x100 ... 0x13c:
+        n = (offset - 0x100) >> 2;
+        return n < arm_num_brps(cpu) ? env->cp15.dbgbvr[n] : 0;
+    case 0x140 ... 0x17c:
+        n = (offset - 0x140) >> 2;
+        return n < arm_num_brps(cpu) ? env->cp15.dbgbcr[n] : 0;
+    case 0x180 ... 0x1bc:
+        n = (offset - 0x180) >> 2;
+        return n < arm_num_wrps(cpu) ? env->cp15.dbgwvr[n] : 0;
+    case 0x1c0 ... 0x1fc:
+        n = (offset - 0x1c0) >> 2;
+        return n < arm_num_wrps(cpu) ? env->cp15.dbgwcr[n] : 0;
+    case 0xfb4:                           /* DBGLSR: software lock unimplemented */
+        return 0;
+    default:
+        return 0;
+    }
+}
+
+/*
+ * VEX V5: runtime check for ARMv7 address-mismatch breakpoints. Called at the
+ * start of each instruction while mismatch stepping is active (see
+ * arm_mismatch_step_active() / translate.c). Fires a guest breakpoint debug
+ * exception when the executing PC is not the instruction the mismatch
+ * breakpoint covers, matching the semantics vexide/v5gdb relies on for
+ * single-step, continue-past-breakpoint and Ctrl-C halt.
+ */
+void HELPER(vex_mismatch_check)(CPUARMState *env, uint32_t pc)
+{
+    ARMCPU *cpu = env_archcpu(env);
+    int n, brps = arm_num_brps(cpu);
+    int mode = env->uncached_cpsr & CPSR_M;
+
+    if (mode != ARM_CPU_MODE_USR && mode != ARM_CPU_MODE_SVC
+        && mode != ARM_CPU_MODE_SYS) {
+        return;
+    }
+
+    for (n = 0; n < brps; n++) {
+        uint64_t bcr = env->cp15.dbgbcr[n];
+        uint64_t bvr = env->cp15.dbgbvr[n];
+        vaddr addr;
+        int bas;
+
+        if (!extract64(bcr, 0, 1) || extract64(bcr, 20, 4) != 4) {
+            continue;   /* not an enabled address-mismatch breakpoint */
+        }
+
+        bas = extract64(bcr, 5, 4);
+        addr = bvr & ~3ULL;
+        if (bas == 0xc) {
+            addr += 2;
+        }
+
+        if (pc != addr) {
+            env->exception.fsr = arm_debug_exception_fsr(env);
+            env->exception.vaddress = 0;
+            raise_exception_debug(env, EXCP_PREFETCH_ABORT, syn_breakpoint(0));
+        }
+    }
+}
